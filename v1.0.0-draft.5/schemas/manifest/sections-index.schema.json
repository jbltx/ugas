{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ugas.jbltx.com/v1.0.0-draft.5/schemas/manifest/sections-index.schema.json",
  "title": "UGAS spec section index (sections/index.json)",
  "description": "Schema for the pre-chunked spec section index. Generated by scripts/build_sections.py.",
  "type": "object",
  "required": ["sections"],
  "additionalProperties": false,
  "properties": {
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "level", "pillar", "parentId", "anchor", "path", "bytes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable slug derived from the heading with the leading number stripped.",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": { "type": "string" },
        "level": { "type": "integer", "enum": [1, 2] },
        "pillar": {
          "type": ["string", "null"],
          "enum": ["attributes", "tags", "abilities", "effects", null]
        },
        "parentId": { "type": ["string", "null"] },
        "anchor": { "type": "string", "pattern": "^#" },
        "path": { "type": "string", "pattern": "^sections/" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
