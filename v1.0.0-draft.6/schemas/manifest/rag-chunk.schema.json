{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ugas.jbltx.com/v1.0.0-draft.6/schemas/manifest/rag-chunk.schema.json",
  "title": "UGAS RAG chunk (one line of rag/chunks.jsonl)",
  "description": "Schema for a single retrieval chunk. Generated by scripts/build_rag.py.",
  "type": "object",
  "required": ["id", "version", "pillar", "sectionId", "headingPath", "anchor", "sourceUrl", "tokens", "sha256", "text"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "pillar": {
      "type": ["string", "null"],
      "enum": ["attributes", "tags", "abilities", "effects", null]
    },
    "sectionId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "headingPath": { "type": "string" },
    "anchor": { "type": "string", "pattern": "^#" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "tokens": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1 }
  }
}
