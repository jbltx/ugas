{
  "version": 1,
  "id": "N4-clock-only-expiry",
  "description": "Clock-only checks age prediction without ticking gameplay or recording simulation steps.",
  "model": "prediction",
  "initial": {
    "period_ms": 10,
    "tick_mana": 5
  },
  "steps": [
    {
      "op": "submit",
      "args": {
        "base": 1,
        "nodes": [
          {
            "sub": 0,
            "parent": null,
            "cost": 10
          }
        ]
      },
      "expect": {
        "state": {
          "mana": 90,
          "tags": [
            "1:0"
          ],
          "cooldowns": [
            "1:0"
          ],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 0
          }
        },
        "history_frames": 1
      }
    },
    {
      "op": "advance",
      "args": {
        "milliseconds": 100,
        "frames": 0
      },
      "expect": {
        "state": {
          "mana": 90,
          "tags": [
            "1:0"
          ],
          "cooldowns": [
            "1:0"
          ],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 0
          }
        },
        "history_frames": 1,
        "ready": true
      }
    },
    {
      "op": "advance",
      "args": {
        "milliseconds": 0,
        "frames": 0,
        "simulation_ms": 0
      },
      "expect": {
        "history_frames": 1,
        "trace": [
          "send:1",
          "predict:1"
        ]
      }
    },
    {
      "op": "advance",
      "args": {
        "milliseconds": 1,
        "frames": 0,
        "simulation_ms": 1
      },
      "error": "simulation time requires frame progress",
      "expect": {
        "state": {
          "mana": 90,
          "tags": [
            "1:0"
          ],
          "cooldowns": [
            "1:0"
          ],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 0
          }
        },
        "history_frames": 1
      }
    },
    {
      "op": "advance",
      "args": {
        "milliseconds": 150,
        "frames": 0
      },
      "expect": {
        "state": {
          "mana": 100,
          "tags": [],
          "cooldowns": [],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 0
          }
        },
        "history_frames": 0,
        "ready": false,
        "pending": [
          1
        ]
      }
    }
  ]
}
