{
  "version": 1,
  "id": "N8-pending-budget",
  "description": "Outstanding requests remain bounded even when speculation is unavailable.",
  "model": "prediction",
  "initial": {
    "max_requests": 1
  },
  "steps": [
    {
      "op": "submit",
      "args": {
        "base": 1,
        "nodes": [
          {
            "sub": 0,
            "parent": null,
            "cost": 10
          }
        ],
        "predictable": false
      }
    },
    {
      "op": "submit",
      "args": {
        "base": 2,
        "nodes": [
          {
            "sub": 0,
            "parent": null,
            "cost": 10
          }
        ]
      },
      "expect": {
        "pending": [
          1
        ]
      },
      "error": "request budget exhausted"
    }
  ]
}
