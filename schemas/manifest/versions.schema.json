{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ugas.jbltx.com/%%UGAS_VERSION%%/schemas/manifest/versions.schema.json",
  "title": "UGAS versions manifest (versions.json)",
  "description": "Schema for the root versions.json: all published versions plus a latest alias. Generated by scripts/build-landing-page.sh.",
  "type": "object",
  "required": ["latest", "versions"],
  "additionalProperties": false,
  "properties": {
    "latest": { "type": "string", "pattern": "^v[0-9A-Za-z.+-]+$" },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "status", "released", "changelog"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^v[0-9A-Za-z.+-]+$" },
          "status": { "type": "string" },
          "released": { "type": "string" },
          "changelog": { "type": "string" }
        }
      }
    }
  }
}
