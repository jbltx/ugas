{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ugas.jbltx.com/%%UGAS_VERSION%%/schemas/manifest/index.schema.json",
  "title": "UGAS resource manifest (index.json)",
  "description": "Schema for the per-version resource manifest that enumerates every published UGAS resource with checksums. Generated by scripts/build_manifest.py.",
  "type": "object",
  "required": ["spec", "version", "resources"],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "type": "string",
      "const": "ugas"
    },
    "version": {
      "type": "string",
      "description": "Version token without the leading 'v' (a release is semver; previews use a dev-<sha> tag).",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "Optional ISO-8601 build timestamp."
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["id", "kind", "title", "path", "url", "mediaType", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "spec",
            "spec-source",
            "spec-section",
            "section-index",
            "schema",
            "schema-bundle",
            "meta-schema",
            "example",
            "genre-index",
            "genre-pack-spec",
            "genre-entity",
            "conformance",
            "rag",
            "html",
            "doc",
            "other"
          ]
        },
        "title": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Docs-root-relative, version-scoped (v<version>/...).",
          "pattern": "^v[0-9A-Za-z.+-]+/"
        },
        "url": { "type": "string", "format": "uri" },
        "mediaType": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
