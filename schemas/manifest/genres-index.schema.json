{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ugas.jbltx.com/%%UGAS_VERSION%%/schemas/manifest/genres-index.schema.json",
  "title": "UGAS genre pack index (genres/index.json)",
  "description": "Schema for the genre pack + entity manifest. Generated by scripts/build_genre_manifest.py.",
  "type": "object",
  "required": ["spec", "version", "packs"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string", "const": "ugas" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$" },
    "packs": { "type": "array", "items": { "$ref": "#/$defs/pack" } }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "required": ["id", "title", "scope", "signatureMechanic", "specPath", "entities"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "scope": { "type": ["string", "null"] },
        "signatureMechanic": { "type": ["string", "null"] },
        "specPath": { "type": "string", "pattern": "^v[0-9A-Za-z.+-]+/genres/" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": ["string", "null"] },
        "path": { "type": "string", "pattern": "^v[0-9A-Za-z.+-]+/genres/" }
      }
    }
  }
}
