{
  "version": 1,
  "id": "N7-idle-periodic-replay",
  "description": "Idle simulation steps and periodic phase/count replay using recorded delta time.",
  "model": "prediction",
  "initial": {
    "period_ms": 10,
    "tick_mana": 5
  },
  "steps": [
    {
      "op": "submit",
      "args": {
        "base": 1,
        "nodes": [
          {
            "sub": 0,
            "parent": null,
            "cost": 10
          }
        ]
      }
    },
    {
      "op": "advance",
      "args": {
        "milliseconds": 10,
        "simulation_ms": 10
      },
      "expect": {
        "state": {
          "mana": 95,
          "cooldowns": [
            "1:0"
          ],
          "tags": [
            "1:0"
          ],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 1
          }
        }
      }
    },
    {
      "op": "update",
      "args": {
        "revision": 1,
        "state": {
          "mana": 100,
          "cooldowns": [],
          "tags": [],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 0
          }
        },
        "outcomes": [],
        "checkpoint_frame": 0
      },
      "expect": {
        "state": {
          "mana": 95,
          "cooldowns": [
            "1:0"
          ],
          "tags": [
            "1:0"
          ],
          "effects": [],
          "period": {
            "elapsed": 0,
            "count": 1
          }
        },
        "history_frames": 2
      }
    }
  ]
}
